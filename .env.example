# 视频翻译系统环境配置示例
# 复制此文件为 .env 并填写实际配置值

# ==================== API配置 ====================
# 阿里云百炼平台API密钥（必需）
DASHSCOPE_API_KEY=your_actual_api_key_here

# API服务地址
API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# 模型名称
# 实时音视频翻译模型：qwen-omni-turbo 或 qwen-omni-turbo-latest
MODEL_NAME=qwen-omni-turbo

# 目标语言
TARGET_LANGUAGE=en

# 语音类型
VOICE_TYPE=Cherry

# ==================== 音频配置 ====================
# 输入音频采样率
INPUT_SAMPLE_RATE=16000

# 输出音频采样率
OUTPUT_SAMPLE_RATE=24000

# 音频数据块大小
AUDIO_CHUNK_SIZE=1600

# 音频格式
AUDIO_FORMAT=pcm16

# 声道数
CHANNELS=1

# ==================== 视频配置 ====================
# 视频帧提取频率（帧/秒）
FRAME_EXTRACT_RATE=2

# 输出视频质量（high/medium/low）
OUTPUT_VIDEO_QUALITY=high

# 视频编码器
VIDEO_CODEC=h264

# 音频编码器
AUDIO_CODEC=aac

# 音频比特率
AUDIO_BITRATE=128k

# ==================== 处理配置 ====================
# 最大重试次数
MAX_RETRY_COUNT=3

# 超时时间（秒）
TIMEOUT_SECONDS=30

# 并发工作线程数
CONCURRENT_WORKERS=4

# 缓冲区大小
BUFFER_SIZE=8192

# ==================== 文件路径配置 ====================
# 输入视频路径
INPUT_VIDEO_PATH=videos/cn-agent.mp4

# 输出视频路径
OUTPUT_VIDEO_PATH=output/cn-agent-en.mp4

# 临时文件目录
TEMP_DIR=temp/

# 日志目录
LOG_DIR=logs/

# ==================== 日志配置 ====================
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志文件名（可选，留空则只输出到控制台）
LOG_FILE=

# ==================== 注意事项 ====================
# 1. 请务必设置真实的 DASHSCOPE_API_KEY
# 2. 确保系统已安装 ffmpeg 和 ffprobe 命令行工具
# 3. 输入视频文件需要包含音频轨道
# 4. 处理大文件需要足够的磁盘空间（约为原视频的3倍）
